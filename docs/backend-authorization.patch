+++ b/AuthorizationChecks/Program.cs
@@ -0,0 +1,47 @@
+using System.Reflection;
+using MeuPetshop.Api.Controllers;
+using MeuPetShop.Domain.Dtos.Auth;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Routing;
+
+var publicActions = new HashSet<string> { "Login", "ForgotPassword", "ResetPassword" };
+var count = 0;
+foreach (var controller in typeof(AuthController).Assembly.GetTypes()
+    .Where(type => typeof(ControllerBase).IsAssignableFrom(type)))
+{
+    foreach (var method in controller.GetMethods().Where(method => method.GetCustomAttributes<HttpMethodAttribute>().Any()))
+    {
+        if (controller == typeof(AuthController) && publicActions.Contains(method.Name)) continue;
+        var policies = controller.GetCustomAttributes<AuthorizeAttribute>()
+            .Concat(method.GetCustomAttributes<AuthorizeAttribute>()).ToArray();
+        if (policies.Length == 0) throw new Exception($"Unprotected action: {controller.Name}.{method.Name}");
+        count++;
+    }
+}
+
+void RequireRoles(Type controller, string action, params string[] expected)
+{
+    var actual = controller.GetMethod(action)!.GetCustomAttributes<AuthorizeAttribute>()
+        .SelectMany(attribute => (attribute.Roles ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
+        .Order().ToArray();
+    if (!actual.SequenceEqual(expected.Order())) throw new Exception($"Incorrect roles: {controller.Name}.{action}");
+}
+
+RequireRoles(typeof(AuthController), "Register", "Admin", "SuperAdmin");
+RequireRoles(typeof(AuthController), "GetAllUsers", "SuperAdmin");
+RequireRoles(typeof(AuthController), "DeleteUser", "SuperAdmin");
+RequireRoles(typeof(ProductsController), "UpdateProduct", "Admin", "SuperAdmin");
+RequireRoles(typeof(ProductsController), "DeleteProduct", "Admin", "SuperAdmin");
+RequireRoles(typeof(ClientsController), "DeleteClient", "Admin", "SuperAdmin");
+RequireRoles(typeof(PetsController), "DeletePet", "Admin", "SuperAdmin");
+RequireRoles(typeof(ServicesController), "DeleteService", "Admin", "SuperAdmin");
+
+// Null dependencies prove invalid roles are rejected before any user is created.
+var auth = new AuthController(null!, null!, null!);
+foreach (var role in new[] { "SuperAdmin", " SuperAdmin ", "Unknown", "admin" })
+{
+    var result = await auth.Register(new RegisterDto("test", "test@example.com", "Password1!", "Test", role));
+    if (result is not BadRequestObjectResult) throw new Exception($"Accepted privileged role: {role}");
+}
+Console.WriteLine($"PASS: {count} protected actions, 8 role policies and 4 invalid role assignments.");
